# Copy to .env and fill in. Never commit the real file.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgres://borrowings:CHANGE_ME@localhost:5432/borrowings
# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts two-step verification secrets and stored documents. Back it up: without it, stored documents cannot be read.
APP_ENCRYPTION_KEY=
# Must be true in production (requires HTTPS).
COOKIE_SECURE=true
# true when running behind a reverse proxy / load balancer that sets X-Forwarded-For
TRUST_PROXY=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Price feed: "manual" (entered on screen or pushed via POST /api/v1/prices) or "simulated" (demo random walk, NOT market data)
PRICE_PROVIDER=manual
PRICE_POLL_SECONDS=30

UPLOAD_DIR=./storage/documents
MAX_UPLOAD_MB=25

# Alert delivery (optional). Without these, alerts still show in the app.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=Borrowings System <treasury-alerts@example.com>
# SMS_WEBHOOK_URL=https://sms-gateway.example.com/send     (receives JSON {to, body})
# SMS_WEBHOOK_TOKEN=
